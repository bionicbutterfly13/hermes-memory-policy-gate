{
  "cases": [
    {
      "name": "conversational acknowledgement is not durable memory",
      "request": {
        "text": "yeah ok",
        "source": "chat"
      },
      "expected_tier": "session_search_only"
    },
    {
      "name": "durable user preference routes to user memory",
      "request": {
        "text": "I prefer concise approvals and blockers instead of long dumps.",
        "source": "chat"
      },
      "expected_tier": "user_memory"
    },
    {
      "name": "reusable procedure routes to skill patch",
      "request": {
        "text": "This is a reusable workflow checklist for memory routing.",
        "source": "session"
      },
      "expected_tier": "skill_patch"
    },
    {
      "name": "clean field unapproved marketing source blocks writes",
      "request": {
        "text": "Use this old campaign detail for Quill marketing memory.",
        "source": "floating memory"
      },
      "expected_tier": "no_write_clean_field_boundary"
    },
    {
      "name": "active lane state routes to Mnemosyne session",
      "request": {
        "text": "Active lane is Hermes plugin productization; source of truth is PLAN.md.",
        "source": "control-plane"
      },
      "expected_tier": "mnemosyne_session"
    },
    {
      "name": "project artifact stays near repo",
      "request": {
        "text": "Update README and pyproject.toml in the project repo.",
        "source": "task"
      },
      "expected_tier": "project_artifact"
    },
    {
      "name": "superseding correction requires update path",
      "request": {
        "text": "Correction: HBD is not the machine; it is an offer instance.",
        "source": "chat"
      },
      "expected_tier": "superseded_update"
    },
    {
      "name": "noisy memory invalidation is gated",
      "request": {
        "text": "Remove noisy memory about assistant summaries.",
        "source": "audit",
        "metadata": {
          "operation": "invalidate"
        }
      },
      "expected_tier": "noisy_memory_invalidation"
    },
    {
      "name": "completed task progress is not durable memory",
      "request": {
        "text": "Fixed bug X, submitted PR #123, and completed Phase 4 today.",
        "source": "assistant_session_summary"
      },
      "expected_tier": "session_search_only"
    },
    {
      "name": "user memory write attempt blocks ephemeral task progress",
      "request": {
        "text": "Remember that I submitted PR #123 and completed Phase 4 today.",
        "source": "assistant_session_summary",
        "dry_run": false,
        "metadata": {
          "requested_tier": "user_memory"
        }
      },
      "expected_tier": "session_search_only",
      "expected_blocked": true,
      "expected_enforced": true,
      "expected_enforcement_action": "block_user_memory_write"
    },
    {
      "name": "durable user preference remains advisory for user memory write attempt",
      "request": {
        "text": "I prefer concise approvals and blockers instead of long dumps.",
        "source": "chat",
        "dry_run": false,
        "metadata": {
          "requested_tier": "user_memory"
        }
      },
      "expected_tier": "user_memory",
      "expected_blocked": false,
      "expected_enforced": false,
      "expected_enforcement_action": "advisory_only"
    },
    {
      "name": "global operating rule routes to Mnemosyne global",
      "request": {
        "text": "This is a durable cross-session operating rule for Archimedes.",
        "source": "control-plane"
      },
      "expected_tier": "mnemosyne_global"
    },
    {
      "name": "phase4 live user preference write intent stays advisory",
      "live_write_intent": true,
      "request": {
        "text": "I prefer concise status reports.",
        "source": "memory_tool",
        "dry_run": false,
        "metadata": {
          "live_write_intent": true,
          "entrypoint": "tools.memory_tool.memory_tool",
          "write_path": "builtin_memory_tool",
          "requested_tier": "user_memory",
          "action": "add",
          "target": "user"
        }
      },
      "expected_tier": "user_memory",
      "expected_blocked": false,
      "expected_enforced": false,
      "expected_enforcement_action": "advisory_only",
      "expected_dry_run": true,
      "expected_would_mutate": false,
      "expected_approval_required": false
    },
    {
      "name": "phase4 mnemosyne global write intent stays advisory",
      "live_write_intent": true,
      "request": {
        "text": "This is a durable cross-session operating rule for Archimedes.",
        "source": "memory_provider",
        "dry_run": false,
        "metadata": {
          "live_write_intent": true,
          "entrypoint": "agent.memory_manager.sync_all",
          "write_path": "memory_provider_sync_turn",
          "requested_tier": "mnemosyne_global"
        }
      },
      "expected_tier": "mnemosyne_global",
      "expected_blocked": false,
      "expected_enforced": false,
      "expected_enforcement_action": "advisory_only",
      "expected_dry_run": true,
      "expected_would_mutate": false,
      "expected_approval_required": false
    },
    {
      "name": "phase4 mnemosyne session write intent stays advisory",
      "live_write_intent": true,
      "request": {
        "text": "Active lane is Hermes plugin productization; source of truth is PLAN.md.",
        "source": "memory_provider",
        "dry_run": false,
        "metadata": {
          "live_write_intent": true,
          "entrypoint": "agent.memory_manager.on_session_end",
          "write_path": "memory_provider_session_state",
          "requested_tier": "mnemosyne_session"
        }
      },
      "expected_tier": "mnemosyne_session",
      "expected_blocked": false,
      "expected_enforced": false,
      "expected_enforcement_action": "advisory_only",
      "expected_dry_run": true,
      "expected_would_mutate": false,
      "expected_approval_required": false
    },
    {
      "name": "phase4 skill patch write intent stays advisory",
      "live_write_intent": true,
      "request": {
        "text": "Reusable workflow checklist for memory routing should become a skill patch.",
        "source": "skill_manage",
        "dry_run": false,
        "metadata": {
          "live_write_intent": true,
          "entrypoint": "tools.skill_manager_tool.skill_manage",
          "write_path": "skill_patch",
          "requested_tier": "skill_patch",
          "action": "patch"
        }
      },
      "expected_tier": "skill_patch",
      "expected_blocked": false,
      "expected_enforced": false,
      "expected_enforcement_action": "advisory_only",
      "expected_dry_run": true,
      "expected_would_mutate": false,
      "expected_approval_required": false
    },
    {
      "name": "phase4 project artifact write intent stays advisory",
      "live_write_intent": true,
      "request": {
        "text": "Update README and pyproject.toml in the project repo.",
        "source": "file_tool",
        "dry_run": false,
        "metadata": {
          "live_write_intent": true,
          "entrypoint": "tools.file_tools.write_file_tool",
          "write_path": "project_artifact",
          "requested_tier": "project_artifact"
        }
      },
      "expected_tier": "project_artifact",
      "expected_blocked": false,
      "expected_enforced": false,
      "expected_enforcement_action": "advisory_only",
      "expected_dry_run": true,
      "expected_would_mutate": false,
      "expected_approval_required": false
    },
    {
      "name": "phase4 clean-field write intent requires approval and no mutation",
      "live_write_intent": true,
      "request": {
        "text": "Use this old campaign detail for Quill marketing memory.",
        "source": "memory_tool",
        "dry_run": false,
        "metadata": {
          "live_write_intent": true,
          "entrypoint": "tools.memory_tool.memory_tool",
          "write_path": "builtin_memory_tool",
          "requested_tier": "user_memory"
        }
      },
      "expected_tier": "no_write_clean_field_boundary",
      "expected_blocked": false,
      "expected_enforced": false,
      "expected_enforcement_action": "advisory_only",
      "expected_dry_run": true,
      "expected_would_mutate": false,
      "expected_approval_required": true
    },
    {
      "name": "phase4 session-search-only write intent blocks durable write",
      "live_write_intent": true,
      "request": {
        "text": "Fixed bug X, submitted PR #123, and completed Phase 4 today.",
        "source": "memory_tool",
        "dry_run": false,
        "metadata": {
          "live_write_intent": true,
          "entrypoint": "tools.memory_tool.memory_tool",
          "write_path": "builtin_memory_tool",
          "requested_tier": "memory"
        }
      },
      "expected_tier": "session_search_only",
      "expected_blocked": true,
      "expected_enforced": true,
      "expected_enforcement_action": "block_durable_write",
      "expected_dry_run": false,
      "expected_would_mutate": false,
      "expected_approval_required": false
    }
  ]
}
